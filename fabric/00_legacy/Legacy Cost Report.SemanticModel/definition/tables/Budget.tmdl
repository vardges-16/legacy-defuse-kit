table Budget
	lineageTag: 229d8a67-9301-4200-b45c-2a56e39a640a

	measure 'Monthly Budget' = DIVIDE(SUM(Budget[budget_cost]), DISTINCTCOUNT(Budget[budget_month]))
		formatString: #,0
		lineageTag: 1c55268c-6142-419f-9465-e4e02a5d78ec

	measure 'Actual (mapped)' = CALCULATE([Total Cost (tagged)], TREATAS(VALUES(Budget[cost_center_code]), 'Cost by App'[cost_center_code]))
		formatString: #,0
		lineageTag: 54203319-6efe-45f7-9e98-875458e01de2

	measure Variance = [Actual (mapped)] - [Monthly Budget]
		formatString: #,0
		lineageTag: 6246a1cd-e98d-4196-9a39-eb8f045c543c

	measure 'Budget Year' = MAX(Budget[fiscal_year])
		formatString: 0
		lineageTag: 4520af59-3e06-4d87-bbf5-761b4024614f

	column business_unit_name
		dataType: string
		lineageTag: 16292a21-10df-4b9d-b21b-4b5f54fa821c
		summarizeBy: none
		sourceColumn: business_unit_name

		annotation SummarizationSetBy = Automatic

	column department_name
		dataType: string
		lineageTag: 75f0f2c4-b68f-49b0-b1ed-956262a545e7
		summarizeBy: none
		sourceColumn: department_name

		annotation SummarizationSetBy = Automatic

	column cost_center_code
		dataType: string
		lineageTag: 65558b3e-9be9-4e49-8e3c-f03ad1897637
		summarizeBy: none
		sourceColumn: cost_center_code

		annotation SummarizationSetBy = Automatic

	column cost_center_name
		dataType: string
		lineageTag: 9d64cb2e-e7b9-4e68-85f0-ad4189e9f77a
		summarizeBy: none
		sourceColumn: cost_center_name

		annotation SummarizationSetBy = Automatic

	column fiscal_year
		dataType: int64
		formatString: 0
		lineageTag: 5f12bf7a-189e-40b8-934a-bb964396724f
		summarizeBy: none
		sourceColumn: fiscal_year

		annotation SummarizationSetBy = Automatic

	column budget_month
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 785f7473-84f0-45e3-9026-816c7d8771f2
		summarizeBy: none
		sourceColumn: budget_month

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column budget_cost
		dataType: double
		formatString: #,0.00
		lineageTag: f5da490c-78df-48a3-8369-1f1c67b0a1cc
		summarizeBy: sum
		sourceColumn: budget_cost

		annotation SummarizationSetBy = Automatic

	partition Budget = m
		mode: import
		source =
				let
				    // Legacy: finance budget export read directly from the file share
				    Source = AzureStorage.DataLake("https://saodlepam2446996datalake.dfs.core.windows.net/fin-inputs/fiscalyear=2026"),
				    File = Source{[Name = "financial_budget.csv"]}[Content],
				    Csv = Csv.Document(File, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"business_unit_name", "department_name", "cost_center_code", "cost_center_name", "fiscal_year", "budget_month", "budget_cost"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"fiscal_year", Int64.Type}, {"budget_month", type date}, {"budget_cost", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

