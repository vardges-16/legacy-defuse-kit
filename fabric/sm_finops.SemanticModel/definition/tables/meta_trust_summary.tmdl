table meta_trust_summary
	lineageTag: 8ab81a91-6774-47f1-a5a2-cb307d00382f
	sourceLineageTag: [dbo].[meta_trust_summary]

	/// Time of the latest reconciliation.
	measure 'Last Check' = CALCULATE(MAX(meta_trust_summary[checked_at]), REMOVEFILTERS(meta_trust_summary))
		formatString: dd mmm yyyy hh:nn
		displayFolder: Trust
		lineageTag: c3342512-7f0c-4323-a7e5-fd4a8bc1d290

	/// Entities whose latest reconciliation passed (source = Bronze = Silver = Gold).
	measure 'Entities Reconciled' =
			VAR t = [Last Check]
			RETURN CALCULATE(COUNTROWS(meta_trust_summary), REMOVEFILTERS(meta_trust_summary), meta_trust_summary[checked_at] = t, meta_trust_summary[status] = "PASS")
		formatString: #,0
		displayFolder: Trust
		lineageTag: 94536ba9-65f0-498e-815f-a32a59fa1bca

	/// Entities in the latest reconciliation.
	measure 'Entities Checked' =
			VAR t = [Last Check]
			RETURN CALCULATE(COUNTROWS(meta_trust_summary), REMOVEFILTERS(meta_trust_summary), meta_trust_summary[checked_at] = t)
		formatString: #,0
		displayFolder: Trust
		lineageTag: fcc0cd8c-4148-4237-9e29-030e22b974a9

	/// Rows that disappeared between layers in the latest reconciliation. Must be 0.
	measure 'Rows Lost' =
			VAR t = [Last Check]
			RETURN CALCULATE(SUM(meta_trust_summary[lost_rows]), REMOVEFILTERS(meta_trust_summary), meta_trust_summary[checked_at] = t) + 0
		formatString: #,0
		displayFolder: Trust
		lineageTag: 64f28390-4e41-4734-a754-570ce81f2892

	/// One-line trust statement for report headers.
	measure 'Data Verified' =
			VAR ok = [Entities Reconciled]
			VAR n = [Entities Checked]
			VAR lost = [Rows Lost]
			RETURN IF(n > 0 && ok = n && lost = 0,
			    "✓ Data verified · " & ok & "/" & n & " sources reconciled · 0 rows lost",
			    "⚠ Check the Trust Ledger · " & ok & "/" & n & " reconciled · " & FORMAT(lost, "#,0") & " rows lost")
		displayFolder: Trust
		lineageTag: 0e6b5bb0-c6e2-42c1-83c0-25d7ddf854c7

