		sourceColumn: byol_cores_installed

		annotation SummarizationSetBy = Automatic

	column cores_entitled_active
		dataType: int64
		formatString: 0
		lineageTag: 3f20fb81-5be8-4d80-8658-495f934c3f7b
		sourceLineageTag: cores_entitled_active
		summarizeBy: none
		sourceColumn: cores_entitled_active

		annotation SummarizationSetBy = Automatic

	column cores_expired
		dataType: int64
		formatString: 0
		lineageTag: 8088fa74-1299-4700-b5a8-843177e3142d
		sourceLineageTag: cores_expired
		summarizeBy: none
		sourceColumn: cores_expired

		annotation SummarizationSetBy = Automatic

	column core_shortfall
