table meta_pipeline_runs
	lineageTag: ffef25bd-9859-420b-9725-7b0d03ef6242
	sourceLineageTag: [dbo].[meta_pipeline_runs]

	/// Start of the latest pipeline run.
	measure 'Last Run Start' = CALCULATE(MAX(meta_pipeline_runs[started_at]), REMOVEFILTERS(meta_pipeline_runs))
		formatString: dd mmm yyyy hh:nn
		displayFolder: Trust
		lineageTag: 4a186288-ca08-47f0-8b73-db1ab07aa7e3

	/// Status of the latest pipeline run (Succeeded or Failed).
	measure 'Last Run Status' =
			VAR t = [Last Run Start]
			RETURN CALCULATE(SELECTEDVALUE(meta_pipeline_runs[status], "unknown"), REMOVEFILTERS(meta_pipeline_runs), meta_pipeline_runs[started_at] = t)
		displayFolder: Trust
		lineageTag: 68ed1a14-6661-49c9-9e87-705f0b29d367

	/// Freshness line for report headers.
	measure 'Data As Of' = "Refreshed " & FORMAT([Last Run Start], "dd mmm yyyy, hh:nn") & " UTC · pipeline " & LOWER([Last Run Status])
		displayFolder: Trust
		lineageTag: 4c1ec0ba-7a7f-4919-b1a2-15d334952234

