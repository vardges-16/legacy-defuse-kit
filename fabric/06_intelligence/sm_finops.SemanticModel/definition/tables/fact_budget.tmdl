table fact_budget
	lineageTag: db46a452-e9ee-40b8-a8da-b6d8a0d081b0
	sourceLineageTag: [dbo].[fact_budget]

	/// Approved budget in USD (cleansed: fiscal year mapped to months, x1000 scaling fixed).
	measure Budget = SUM(fact_budget[budget_cost])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Budget
		lineageTag: deff900a-f086-4ae1-b6e5-5d276c97d9ab

	/// Actual minus budget. Positive = over budget.
	measure 'Budget Variance' = IF(NOT ISBLANK([Budget]) || NOT ISBLANK([Actual]), [Actual] - [Budget])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Budget
		lineageTag: 1a6b1868-baab-4a19-ae74-30c75df08598

	/// Variance as a share of budget.
	measure 'Budget Variance %' = DIVIDE([Budget Variance], [Budget])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Budget
		lineageTag: 88f4aab9-49c3-484b-b0cb-e4259049dfb0

	/// Actual as a share of budget.
	measure 'Budget Used %' = DIVIDE([Actual], [Budget])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Budget
		lineageTag: 40cdfb1c-f059-40db-8180-8a28af20c54f

	/// Over or within budget, as text for tables.
	measure 'Budget Status' =
			SWITCH(TRUE(),
			    ISBLANK([Budget]), "no budget",
			    [Budget Variance] > 0, "▲ over",
			    "▼ within")
		displayFolder: Budget
		lineageTag: 312cde9f-b96b-4669-8269-03d99d3376f8

	/// Number of cost centers whose actual exceeds budget in the current selection.
	measure 'Cost Centers Over Budget' = COUNTROWS(FILTER(VALUES(dim_cost_center[cost_center_code]), [Budget Variance] > 0))
		formatString: #,0
		displayFolder: Budget
		lineageTag: ca28f324-725a-4b59-9a82-4a7dbc31b58d

