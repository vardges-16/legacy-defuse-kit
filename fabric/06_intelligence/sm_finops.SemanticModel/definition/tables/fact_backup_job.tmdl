table fact_backup_job
	lineageTag: aba3e197-df75-466d-bfe8-200c6a52f659
	sourceLineageTag: [dbo].[fact_backup_job]

	/// Backup job runs (deduplicated).
	measure 'Backup Jobs' = COUNTROWS(fact_backup_job)
		formatString: #,0
		displayFolder: Backup
		lineageTag: b6e46519-2395-401b-a8d3-196b9d92ddbd

	/// Backup jobs that failed.
	measure 'Failed Jobs' = CALCULATE([Backup Jobs], fact_backup_job[status] = "Failed")
		formatString: #,0
		displayFolder: Backup
		lineageTag: b1245fa5-0532-4e30-b75d-97a7c93f18be

	/// Share of backup jobs that completed.
	measure 'Job Success %' = DIVIDE(CALCULATE([Backup Jobs], fact_backup_job[status] IN {"Completed", "CompletedWithWarnings"}), [Backup Jobs])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Backup
		lineageTag: 408cac6b-fb2a-4c89-8a28-c55fbfe3b255

